# Real data always belongs OUTSIDE Git. These are guardrails, not permission
# to keep household data in a checkout. Never force-add private artifacts.
.local/
private/
data/
datasets/
captures/
recordings/
exports/
results/
runs/
weights/
checkpoints/
logs/
settings/
ultralytics-settings/
**/images/
**/labels/
**/frames/
**/full/
**/sessions/
**/.pm2/
**/pm2-home/

# Camera media and model artifacts; hand-reviewed synthetic SVG stays allowed.
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.heic
# Case-sensitive checkouts must also reject common camera uppercase suffixes.
*.JPG
*.JPEG
*.PNG
*.WEBP
*.GIF
*.BMP
*.TIF
*.TIFF
*.HEIC
*.mp4
*.mkv
*.avi
*.mov
*.ts
*.pt
*.pth
*.onnx
*.engine
*.safetensors
*.ckpt
*.gguf
*.bin
*.npy
*.npz
*.cache
*.pkl
*.pickle
*.zip
*.tar
*.tgz
*.gz

# Labels and text logs; preserve dependency and third-party license notices.
*.txt
!**/requirements*.txt
!**/LICENSE*.txt
!**/NOTICE*.txt
*.log
*.jsonl
*.csv
*manifest*.json
*freeze*.json
*progress*.json
*completion*.json
*status*.json
*deployment*.json
*hashes*.json
**/current.json
**/heartbeat.json
**/run-config.json
**/config.json
**/config.*.json
**/live.json
**/live.yolo.json
**/ecosystem.config.*
dump.pm2*
*.pid
*.sock

# Real dataset/runtime YAML; only reviewed examples and CI definitions allowed.
*.yaml
*.yml
!**/*.example.yaml
!**/*.example.yml
!.github/workflows/*.yml
!.github/workflows/*.yaml

.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
node_modules/
__pycache__/
*.pyc
.venv/
venv/
test-results/
playwright-report/
.DS_Store

# Tracked files/history and embedded data URLs are NOT protected by ignore.
# Review staged text, all reachable history and a clean archive before release.
